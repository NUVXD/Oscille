{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build Oscille (Windows MSVC)",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Wall",
                "/external:W0",
                "/wd5045",
                "/GS-",
                "${workspaceFolder}${/}src${/}*.c",
                "/I${workspaceFolder}${/}include",
                "/external:I${workspaceFolder}${/}external${/}SDL3${/}include${/}",
                "/external:I${workspaceFolder}${/}external${/}SDL3_ttf${/}include${/}",
                "/Fo${workspaceFolder}${/}build${/}",
                "/Fe${workspaceFolder}${/}build${/}Oscille.exe",
                "/link",
                "/LIBPATH:${workspaceFolder}${/}external${/}SDL3${/}lib${/}x64",
                "SDL3.lib",
                "/LIBPATH:${workspaceFolder}${/}external${/}SDL3_ttf${/}lib${/}x64",
                "SDL3_ttf.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "MSVC Compile Task"
        },
        {
            "type": "shell",
            "label": "build Oscille (Linux GCC)",
            "command": "bash",
            "args": [
                "-lc",
                "mkdir -p build && gcc -Wall -Wextra -g -I./src $(pkg-config --cflags sdl3 sdl3-ttf) src/*.c -o build/Oscille $(pkg-config --libs sdl3 sdl3-ttf) -lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Linux GCC build task"
        }
    ]
}